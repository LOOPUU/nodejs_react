<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= book ? book.title : "All Books" %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>
<body>
  <div class="container mt-5">

    <% if (book) { %>
      <!-- กรณีมี book เดียว -->
      <h1>📖 <%= book.title %></h1>
      <p><strong>ผู้แต่ง:</strong> <%= book.author %></p>
      <a href="/books" class="btn btn-secondary">⬅ กลับไปหน้าหลัก</a>

    <% } else if (books) { %>
      <!-- กรณีแสดงหลายเล่ม -->
      <h1>📚 รายการหนังสือทั้งหมด</h1>
      <table class="table table-bordered table-hover">
        <thead class="thead-dark">
          <tr>
            <th>ID</th>
            <th>ชื่อหนังสือ</th>
            <th>ผู้แต่ง</th>
            <th>ดูรายละเอียด</th>
          </tr>
        </thead>
        <tbody>
          <% books.forEach(book => { %>
            <tr>
              <td><%= book.id %></td>
              <td><%= book.title %></td>
              <td><%= book.author %></td>
              <td><a href="/books/<%= book.id %>" class="btn btn-sm btn-info">ดูข้อมูล</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="text-danger">ไม่พบข้อมูล</p>
    <% } %>

  </div>
</body>
</html>
